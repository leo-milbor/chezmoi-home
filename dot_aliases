function yy() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}
# Start a new configuration session in tmux or attach to it if it exists
function tconf-session {
    __ensure-installed "tmux"

    local detached=false
    local session_name="CONFIG"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d | --detach)
                detached=true
                shift
                ;;
            *)
                session_name="$1"
                shift
                ;;
        esac
    done

    __tmux-try-switch $session_name

    __tmux-create-widow "$session_name" "NEOVIM" "CD $HOME/.config/nvim && nvim ."
    __tmux-create-widow "$session_name" "CEREBRUM" "CD $HOME/sources/perso/cerebrum-machinae && nvim ."
    __tmux-create-widow "$session_name" "CRUSH" "CD $HOME/.config/crush && nvim ."
    __tmux-create-widow "$session_name" "TMUX" "CD $HOME/.config/tmux/ && nvim ."

    if [ "$detached" = false ]; then
        tmux select-window -t "$session_name:NEOVIM"
    fi

    __tmux-switch $session_name $detached
}

function totep-session {
    __ensure-installed "tmux"

    local detached=false
    local session_name="SERVICE"
    __tmux-try-switch "$session_name"

    cd "$HOME/sources/govtech/otep/service/" || exit 1

    tmux new-session -d -s "$session_name" -n "TERM"
    __tmux-create-widow "$session_name" "NEOVIM" "GOFLAGS=\"-tags=integration\" nvim ."
    __tmux-create-widow "$session_name" "DOCKER" "lazydocker"

    if [ "$detached" = false ]; then
        tmux select-window -t "$session_name:TERM"
    fi

    __tmux-switch "$session_name" "$detached"
}

# Start a new dev session in tmux or attach to it if it exists
function tdev-session {
    __ensure-installed "tmux"

    local detached=false
    local session_name="$(echo "${PWD##*/}" | tr '[:lower:]' '[:upper:]')"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d | --detach)
                detached=true
                shift
                ;;
            *)
                session_name="$1"
                shift
                ;;
        esac
    done

    __tmux-try-switch "$session_name"

    tmux new-session -d -s "$session_name" -n "TERM"
    __tmux-create-widow "$session_name" "NEOVIM" "nvim ."
    __tmux-create-widow "$session_name" "AI" "crush"

    if [ "$detached" = false ]; then
        tmux select-window -t "$session_name:TERM"
    fi

    __tmux-switch "$session_name" "$detached"
}

__tmux-create-widow() {
    session_name=$1
    window_name=$2
    command=$3

    tmux new-window -t "$session_name" -n "$window_name"
    while ! tmux list-windows -t "$session_name" | grep -q "$window_name"; do
        sleep 0.05
    done
    tmux send-keys -t "$session_name:$window_name" "$command" C-m
}


function __tmux-try-switch {
    session_name=$1
    if tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Session '$session_name' already exists."
        if [ -n "$TMUX" ]; then
            echo "Switching to it..."
            tmux switch-client -t "$session_name"
        else
            echo "Attaching..."
            tmux attach-session -t "$session_name"
        fi
        exit 0
    fi
}

function __tmux-switch {
    session_name=$1
    detached=$2
    if [ "$detached" = true ]; then
        echo "Running in detached mode."
        echo "Attach with: tmux attach -t $session_name"
    elif [ -n "$TMUX" ]; then
        echo "Switching to new session..."
        tmux switch-client -t "$session_name"
    else
        echo "Attaching to new session..."
        tmux attach-session -t "$session_name"
    fi
}

function __ensure-installed {
    tool=$1
    if ! command -v "$tool" &>/dev/null; then
        echo "Error: $tool is not installed."
        exit 1
    fi
}

function fd {
    local dir
    dir=$(fd --type d --strip-cwd-prefix 2>/dev/null | \
            fzf -e +m \
            --height 20% \
            --layout=reverse \
            --border \
        --no-sort) && cd "$dir"
}
