function yy() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# Start a new configuration session in tmux or attach to it if it exists
function tconf-session {
    __ensure-installed "tmux"

    local detached=false
    local session_name="CONFIG"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d | --detach)
                detached=true
                shift
                ;;
            *)
                session_name="$1"
                shift
                ;;
        esac
    done

    __tmux-try-switch $session_name

    tmux new-session -d -s "$session_name" -n "neovim"

    tmux send-keys -t "$session_name:neovim" "cd $HOME/.config/nvim && nvim ." C-m

    tmux new-window -t "$session_name" -n "cerebrum"
    tmux send-keys -t "$session_name:cerebrum" "cd $HOME/sources/perso/cerebrum-machinae && nvim ." C-m

    tmux new-window -t "$session_name" -n "opencode"
    tmux send-keys -t "$session_name:opencode" "cd $HOME/.config/opencode && nvim ." C-m

    tmux new-window -t "$session_name" -n "crush"
    tmux send-keys -t "$session_name:crush" "cd $HOME/.config/crush && nvim ." C-m

    if [ "$detached" = false ]; then
        tmux select-window -t "$session_name:term"
    fi

    echo "Windows created: neovim, crush, cerebrum"
    __tmux-switch $session_name $detached
}

# Start a new dev session in tmux or attach to it if it exists
function tdev-session {
    __ensure-installed "tmux"

    local detached=false
    local session_name="$(echo "${PWD##*/}" | tr '[:lower:]' '[:upper:]')"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d | --detach)
                detached=true
                shift
                ;;
            *)
                session_name="$1"
                shift
                ;;
        esac
    done

    __tmux-try-switch "$session_name"

    tmux new-session -d -s "$session_name" -n "term"

    tmux new-window -t "$session_name" -n "neovim"
    tmux send-keys -t "$session_name:neovim" "nvim ." C-m

    tmux new-window -t "$session_name" -n "ai"
    tmux send-keys -t "$session_name:ai" "opencode" C-m

    if [ "$detached" = false ]; then
        tmux select-window -t "$session_name:term"
    fi

    echo "Windows created: term, neovim, ai"
    __tmux-switch "$session_name" "$detached"
}

function __tmux-try-switch {
    session_name=$1
    if tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Session '$session_name' already exists."
        if [ -n "$TMUX" ]; then
            echo "Switching to it..."
            tmux switch-client -t "$session_name"
        else
            echo "Attaching..."
            tmux attach-session -t "$session_name"
        fi
        exit 0
    fi
}

function __tmux-switch {
    session_name=$1
    detached=$2
    if [ "$detached" = true ]; then
        echo "Running in detached mode."
        echo "Attach with: tmux attach -t $session_name"
    elif [ -n "$TMUX" ]; then
        echo "Switching to new session..."
        tmux switch-client -t "$session_name"
    else
        echo "Attaching to new session..."
        tmux attach-session -t "$session_name"
    fi
}

function __ensure-installed {
    tool=$1
    if ! command -v "$tool" &>/dev/null; then
        echo "Error: $tool is not installed."
        exit 1
    fi
}

