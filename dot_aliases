function yy() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# Start a new configuration session in tmux or attach to it if it exists
function conf_session {
    __ensure_installed "tmux" || return 1

    local detached="$1:-false"
    local session_name="CONFIG"

    __tmux_try_switch $session_name && return 0

    __tmux_create_window "$session_name" "HOME" "CD $HOME"
    __tmux_create_window "$session_name" "NEOVIM" "CD $HOME/.config/nvim && nvim ."
    __tmux_create_window "$session_name" "CEREBRUM" "CD $HOME/sources/perso/cerebrum-machinae && nvim ."
    __tmux_create_window "$session_name" "CRUSH" "CD $HOME/.config/crush && nvim ."
    __tmux_create_window "$session_name" "TMUX" "CD $HOME/.config/tmux/ && nvim ."

    if [ "$detached" = false ]; then
        tmux select-window -t "$session_name:NEOVIM"
    fi

    __tmux_switch $session_name $detached
}

# Start a new dev session in tmux or attach to it if it exists
function dev_session {
    __ensure_installed "tmux" || return 1

    local detached=false
    local session_name="$(echo "${PWD##*/}" | tr '[:lower:]' '[:upper:]')"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d | --detach)
                detached=true
                shift
                ;;
            *)
                session_name="$1"
                shift
                ;;
        esac
    done

    __tmux_try_switch "$session_name" && return 0

    tmux new-session -d -s "$session_name" -n "TERM"
    __tmux_create_window "$session_name" "NEOVIM" "nvim ."
    __tmux_create_window "$session_name" "CRUSH" "crush"
    __tmux_create_window "$session_name" "DOCKER" "lazydocker"

    if [ "$detached" = false ]; then
        tmux select-window -t "$session_name:TERM"
    fi

    __tmux_switch "$session_name" "$detached"
}

function ff {
    local dir
    dir=$(fd --type d --strip-cwd-prefix 2>/dev/null | \
            fzf -e +m \
            --height 20% \
            --layout=reverse \
            --border \
        --no-sort) && cd "$dir"
}
