[alias]
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
	st = status
	ci = commit
	ciam = commit -am
	ciamend = commit --amend
	ciaamend = commit -a --amend
	cim = commit -m
	co = checkout
	sw = switch
	br = branch
	fb = !git switch $(git branch --format '%(refname:short)' | gum choose)
	fba = !git branch -a --format '%(refname:short)' | fzf | sed 's/origin//' | cut -c 2- | xargs git switch
  dbz = !git branch --format '%(refname:short)' | grep -v main | gum choose --no-limit | xargs git branch -D
	pulp = pull -p
	fere = fetch && git rebase
	please = push --force-with-lease
	diff = diff | xargs bat --diff

[color "branch"]
  current = green
  local = yellow
  remote = red

[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto

[commit]
	gpgsign = true

[core]
	autocrlf = input
  pager = delta

[credential "https://github.com"]
	helper = 
{{- if .work }}
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}

[credential "https://gist.github.com"]
	helper = 
{{- if .work }}
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- else }}
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
{{- end }}

[delta]
  navigate = true

[diff]
	colorMoved = true
	colormovedws = allow-indentation-change
  tool = nvimdiff

[fetch]
	prune = true
	pruneTags = true

{{- if .work}}
[includeIf "gitdir:~/sources/govtech/"]
    path = ~/sources/govtech/.gitconfig
{{- end }}

[init]
	defaultBranch = main

[interactive]
  diffFilter = delta --color-only

[merge]
  tool = nvimdiff

[pull]
	rebase = true

[push]
  autoSetupRemote = true
  default = current

[tag]
	gpgSign = true
