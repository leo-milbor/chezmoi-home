function source_if_exists {
    file_to_source="$1"
    [ -f "$1" ] && source "$1"
}

source_if_exists "$HOME/.env"
if [ -d "$HOME/.config/shell/lib" ]; then
    for lib in "$HOME"/.config/shell/lib/*.sh; do
        source_if_exists "$lib"
    done
    unset lib
fi
source_if_exists "$HOME/.aliases"
{{- if .work }}
source_if_exists "$HOME/sources/govtech/otep/.profile"
{{- end }}
