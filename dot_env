export EDITOR='nvim'

# PATH
extra_path_dirs=(
    "$HOME/bin"
    "$HOME/.local/bin"
)
for dir in "${extra_path_dirs[@]}"; do
    [ -d "$dir" ] || continue
    case ":$PATH:" in
        *":$dir:"*) ;;
        *) PATH="$PATH:$dir" ;;
    esac
done
export PATH
unset extra_path_dirs dir

# Global AI Prompt Path and core commands
export CEREBRUM_MACHINAE="$HOME/sources/perso/cerebrum-machinae/main"
# Enable opentelemetry for opencode
export OPENCODE_ENABLE_TELEMETRY=1
export OLLAMA_HOST="http://127.0.0.1:11434"

# secrets
[ -s "$HOME/.secrets" ] && \. "$HOME/.secrets"

# fzf
## use ripgrep instead of find
export FZF_DEFAULT_COMMAND='rg --files --hidden'
## add preview for files
export FZF_DEFAULT_OPTS="--height 50% -1 --layout=reverse-list --multi --preview='[[ \$(file --mime {}) =~ binary ]] && echo {} is a binary file || (bat --style=numbers --color=always {} || cat {}) 2> /dev/null | head -300'"
